{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NorthStar Connect",
  "version": "0.6.1",
  "identifier": "com.northstar.connect.desktop",
  "build": {
    "frontendDist": "../../web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NorthStar Connect",
        "url": "desktop.html",
        "width": 1440,
        "height": 940,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data: blob: https: http:; style-src 'self' 'unsafe-inline' https:; script-src 'self' 'unsafe-inline' https:; connect-src ipc: http://ipc.localhost https: http: ws: wss:; frame-src 'self'; font-src 'self' data: https:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
